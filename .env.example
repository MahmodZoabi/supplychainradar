# ── Required ─────────────────────────────────────────────────────────────────
# Flask session signing key — change to a long random string in production
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Anthropic API key — powers AI news classification (Haiku) and risk
# narrative generation (Sonnet).  Get one free at https://console.anthropic.com
# Without this key the app still works: news fetches via Google RSS but
# articles are passed through without AI classification.
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to "false" in production
FLASK_DEBUG=false

# Lead time threshold in days — suppliers above this are flagged (default: 45)
LEAD_TIME_THRESHOLD_DAYS=45

# News cache TTL in seconds (default: 3600 = 1 hour)
NEWS_CACHE_TTL_SECONDS=3600
